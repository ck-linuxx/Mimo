{
  "name": "my-expo-app",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "resolutions": {
    "tslib": "2.8.1"
  },
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "db:generate": "drizzle-kit generate && node scripts/check-migrations.js",
    "db:check": "node scripts/check-migrations.js",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "build:apk": "ANDROID_HOME=$HOME/Android/Sdk bunx eas-cli build --platform android --profile preview --local",
    "build:aab": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@wuba/react-native-echarts": "^3.0.1",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.0.0",
    "expo": "~57.0.0",
    "expo-background-task": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "^57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "nativewind": "latest",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "tslib": "2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
